#!/bin/bash
# lab: a walled room for AI agents. See README.md for the why, and
# `lab --help` for use. Needs Lima 2.2.0+. Written for the bash macOS ships.
#
# Touches: creates/deletes/starts/stops Lima instances it built, and no
# others; creates secrets, state and git-store directories (mode 700) if missing;
# at each entry, refreshes the agent's ~/.lab/keys/ in the guest
# from the secrets directory; `harden` moves .git directories into
# $LAB_GIT_STORE; `unharden` reverses it. `uninstall` stops/deletes Lab-built
# instances, restores protected metadata, then removes the ~/.lab entry.
# It never follows relocation links to delete their targets.
# State is mounted into its own instance only. Outside explicit uninstall,
# host code never writes into it beyond creating the directory, and never
# reads files from it.
#
# A .git directory inside a writable mount is writable by the agent, and the
# host runs what it finds there the next time you use git there. `harden`
# moves it into $LAB_GIT_STORE behind an immutable pointer.

LIMACTL=(limactl --log-level warn)
# Only the coordinator owns descriptor 9. No Lima child may retain its lock.
lima() { "${LIMACTL[@]}" "$@" 9>&-; }
REPO=$(dirname "$(dirname "$(realpath "$0")")")
# Home by its physical path, so everything built from it - the default store,
# the secrets directory, Lima's state - compares truly against the
# physically resolved mounts.
HOME=$(cd -P "$HOME" && pwd)
STORE=${LAB_GIT_STORE:-$HOME/.lab/git}
LIMA_DIR=${LIMA_HOME:-$HOME/.lima}
GUEST=$REPO/guest   # only bin/ and the selected mixin directories reach a room
IMAGE=https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-arm64.img

warn() { echo "lab: $*" >&2; }
die()  { warn "$*"; exit 1; }

usage() {
  cat <<'USAGE'
usage: lab [options] [command [args...]]
       lab [options] -- [args for the default...]
       lab create|rebuild|harden|uninstall [options]
       lab unharden [options] <repo>|--all

  lab            start the default harness, creating the instance first
                 if run from a terminal; no default opens a shell
  lab <command>  run any command on the agent's PATH; lab bash opens a shell
                 another lab joins the room; the last session out stops it
  lab create     create an instance without starting it
  lab rebuild    delete and recreate an instance lab built, its current
                 answers offered back as defaults
  lab harden     move exposed git metadata out of the guest's reach
  lab unharden   move protected metadata home for one repo, or --all
  lab uninstall  stop/delete Lab's instances, unharden repos, remove ~/.lab
                 always asks for confirmation, even with --yes

  --instance <name>        which instance (default: lab); not for removal
  --yes                    take every default without asking; on create the
                           defaults are empty: a bare room, walls only,
                           no user mounts or mixins
  -n                       dry run: every check and the plan, nothing changed
  --all                    unharden every repo in the selected store
  --show                   print the generated Lima config
  --cpus/--memory/--disk   passed through to limactl create

Keys come from ~/.lab/secrets/<instance>, created empty (mode 700) with the
instance: each file becomes the environment variable it's named for, in
every guest shell, replaced at every start.
Each room's state lives in ~/.lab/state/<instance>, read-write at
/mnt/lab-state in that room alone. Harness transcripts there survive a
rebuild; guest-only files and sign-ins do not.
USAGE
}

# Is $1 inside (or equal to) $2?
within()   { [[ $1/ == "$2"/* ]]; }
overlaps() { within "$1" "$2" || within "$2" "$1"; }

# physical <path>: its physical form without creating it - its own if it
# exists, else its nearest existing ancestor's with the rest appended.
physical() {
  if [[ -d $1 ]]; then
    cd -P "$1" && pwd
  elif [[ -L $1 ]]; then
    warn "Can't resolve directory symlink $1: its target must exist."
    return 1
  elif [[ $1 == */* ]]; then
    parent=${1%/*}
    parent=$(physical "${parent:-/}") || return 1
    echo "$parent/${1##*/}"
  else
    return 1
  fi
}

# ask_yes <question> <default: y|n>. With --yes, or at the end of input,
# the default.
ask_yes() {
  hint="[y/N]"
  [[ $2 == y ]] && hint="[Y/n]"
  answer=""
  [[ $YES ]] || read -p "$1 $hint " answer
  [[ ${answer:-$2} == [yY]* ]]
}

# confirm <question>: yes under --yes; otherwise asked, defaulting to no.
confirm() { [[ $YES ]] || ask_yes "$1" n; }

require_lima() {
  v=$(lima --version) || die "Lab needs Lima 2.2.0+: https://lima-vm.io"
  v=${v##* }
  v=${v#v}
  IFS=. read major minor _ <<< "$v"
  (( major > 2 || (major == 2 && minor >= 2) )) || die "limactl $v is older than 2.2.0"
}

# --- The instance, as Lima records it -----------------------------------

instance_exists() { lima list --format '{{.Name}}' | grep -qx "$INST"; }
param()           { lima list "$INST" --format "{{index .Config.Param \"$1\"}}"; }

# Lab built it if it carries LabAgentUser. Anything else lab leaves alone.
ours() {
  [[ $(param LabAgentUser) ]] && return
  warn "lab won't touch $INST: lab didn't build it. To replace it, delete it by hand"
  warn "(limactl delete $INST), then run lab."
  return 1
}

# Fills M_RW, M_PT, M_LOC: each mount's writability, guest mount point, and
# host location, from Lima's resolved config. The location comes last, so a
# comma in it survives.
load_mounts() {
  M_RW=(); M_PT=(); M_LOC=()
  while IFS=, read rw pt loc; do
    [[ $loc ]] || continue
    resolved=$(physical "$loc") || return 1
    M_RW+=("$rw"); M_PT+=("${pt:-$loc}"); M_LOC+=("$resolved")
  done <<< "$(lima list "$INST" --format '{{range .Config.Mounts}}{{.Writable}},{{.MountPoint}},{{.Location}}{{"\n"}}{{end}}')"
}

# Separate Lab's own mounts from the user's. Matching the source as well
# as the guest path prevents an unrelated mount from inheriting a privilege.
managed_mount() {
  local mixin j
  [[ $3 == false ]] || return 1
  [[ $1 == /lab/bin && $2 == "$GUEST/bin" ]] && return 0
  for mixin in "${MIX[@]}"; do
    [[ $1 == /lab/mixins/$mixin && $2 == "$GUEST/mixins/$mixin" ]] && return 0
  done
  for j in "${!RESOURCE_LOC[@]}"; do
    [[ $1 == "${RESOURCE_PT[j]}" && $2 == "${RESOURCE_LOC[j]}" ]] && return 0
  done
  return 1
}

user_mounts() {
  USER_RW=(); USER_LOC=(); USER_PT=()
  for i in "${!M_LOC[@]}"; do
    if managed_mount "${M_PT[i]}" "${M_LOC[i]}" "${M_RW[i]}"; then
      continue
    fi
    if [[ ${M_PT[i]} == /mnt/lab-state ]]; then
      [[ ${M_LOC[i]} == "$STATE" && ${M_RW[i]} == true ]] || {
        warn "Refusing: $INST's state mount is not its own state directory. Rebuild it."
        return 1
      }
      continue
    fi
    if within "${M_PT[i]}" /lab; then
      warn "Refusing: $INST has an unexpected Lab source mount at ${M_PT[i]}. Rebuild it."
      return 1
    fi
    USER_LOC+=("${M_LOC[i]}")
    USER_PT+=("${M_PT[i]}")
    [[ ${M_RW[i]} == true ]] && USER_RW+=("${M_LOC[i]}")
  done
  return 0
}

# --- The repo wall -------------------------------------------------------

# repo_wall <writable host directory>...: refuses when this repo overlaps
# one of them.
repo_wall() {
  hits=()
  for loc in "$@"; do
    if overlaps "$REPO" "$loc" || overlaps "$LAB_HOME" "$loc"; then hits+=("$loc"); fi
  done
  (( ${#hits[@]} == 0 )) && return
  warn "Refusing: Lab's code or home ($REPO; $LAB_HOME) overlaps a writable mount: ${hits[*]}"
  warn "Run lab from a clone outside every writable mount."
  return 1
}

# --- The private wall -----------------------------------------------------

# Private regions, including other instances' symlinked secrets and state.
# Only the instance directory names are read, never their contents.
private_paths() {
  PRIVATE=("$LAB_HOME" "$STORE" "$LIMA_DIR")
  for region in "$LAB_HOME/secrets" "$LAB_HOME/state"; do
    p=$(physical "$region") || return 1
    PRIVATE+=("$p")
    for entry in "$region"/*; do
      [[ -d $entry || -L $entry ]] || continue
      p=$(physical "$entry") || return 1
      PRIVATE+=("$p")
    done
  done
}

# User mounts may not enter Lab's home, even read-only. The same applies
# when a private region has been relocated with a symlink.
private_wall() {
  private_paths || return 1
  private_bad=0
  for m in "$@"; do
    if within "$m" "$REPO"; then
      warn "Refusing: user mount $m enters the Lab repo $REPO."
      private_bad=1
    fi
    for p in "${PRIVATE[@]}"; do
      overlaps "$m" "$p" && { warn "Refusing: the mount $m exposes $p to the guest."; private_bad=1; }
    done
  done
  (( private_bad == 0 ))
}

# State is writable, not executable host material. A symlink may relocate
# it, but cannot turn code, secrets, git, Lima state, or another room's
# state into this room's writable mount.
state_wall() {
  if overlaps "$STATE" "$REPO"; then
    [[ $REPO == "$LAB_HOME" && $STATE == "$LAB_HOME/state/$INST" ]] || {
      warn "Refusing: state $STATE overlaps the Lab repo $REPO."
      return 1
    }
  fi
  if overlaps "$STATE" "$LAB_HOME" && [[ $STATE != "$LAB_HOME/state/$INST" ]]; then
    warn "Refusing: state $STATE enters a different region of Lab's home."
    return 1
  fi
  for region in "$LAB_HOME/secrets" "$STORE" "$LIMA_DIR"; do
    p=$(physical "$region") || return 1
    overlaps "$STATE" "$p" && { warn "Refusing: state $STATE exposes $p."; return 1; }
  done
  for entry in "$LAB_HOME/secrets"/* "$LAB_HOME/state"/*; do
    [[ $entry == "$LAB_HOME/state/$INST" ]] && continue
    [[ -d $entry || -L $entry ]] || continue
    p=$(physical "$entry") || return 1
    overlaps "$STATE" "$p" && { warn "Refusing: state $STATE overlaps $entry ($p)."; return 1; }
  done
  return 0
}

# Only the git region is handed in, never a parent containing code, keys
# or another room's state. A relocated store gets the same physical checks.
store_wall() {
  if overlaps "$STORE" "$REPO"; then
    [[ $REPO == "$LAB_HOME" ]] && within "$STORE" "$LAB_HOME/git" || {
      warn "Refusing: git store $STORE overlaps the Lab repo $REPO."
      return 1
    }
  fi
  if overlaps "$STORE" "$LAB_HOME" && ! within "$STORE" "$LAB_HOME/git"; then
    warn "Refusing: git store $STORE enters a different region of Lab's home."
    return 1
  fi
  for region in "$LAB_HOME/secrets" "$LAB_HOME/state" "$LIMA_DIR"; do
    p=$(physical "$region") || return 1
    overlaps "$STORE" "$p" && { warn "Refusing: git store $STORE exposes $p."; return 1; }
  done
  for entry in "$LAB_HOME/secrets"/* "$LAB_HOME/state"/*; do
    [[ -d $entry || -L $entry ]] || continue
    p=$(physical "$entry") || return 1
    overlaps "$STORE" "$p" && { warn "Refusing: git store $STORE exposes $entry ($p)."; return 1; }
  done
  return 0
}

# Existing instances record their store. An environment override may not
# quietly make harden write somewhere other than the instance's origin.
instance_store() {
  recorded=$(param LabGitStore)
  [[ $recorded ]] || return 0   # older instance, before the store was recorded
  recorded=$(physical "$recorded") || return 1
  [[ -d $recorded ]] || {
    warn "Refusing: recorded git store $recorded is missing. Restore it before continuing; it is the protected host metadata location."
    return 1
  }
  if [[ $LAB_GIT_STORE && $STORE != "$recorded" ]]; then
    warn "Refusing: $INST uses git store $recorded, not $STORE. Rebuild to change it."
    return 1
  fi
  STORE=$recorded
}

# Extra mounts are read-only. Protected metadata is an allowed data source,
# whoever requests it; code, secrets, Lima and other rooms' state are not.
readonly_wall() {
  if within "$1" "$STORE"; then
    store_wall
  else
    private_wall "$1"
  fi
}

# --- The git wall --------------------------------------------------------

# .git directories and unlocked pointers in writable mounts. A .git file
# can point at metadata under any name, so directory-only scans miss an
# execution surface. Read-only mirror mounts are pruned; an unrelated
# read-only mount elsewhere protects nothing here.
exposed() {
  roots=(); prunes=()
  for i in "${!M_LOC[@]}"; do
    if [[ ${M_RW[i]} == true ]]; then
      roots+=("${M_LOC[i]}")
    elif [[ ${M_PT[i]} == "${M_LOC[i]}" ]]; then
      prunes+=(-path "${M_LOC[i]}" -prune -o)
    fi
  done
  (( ${#roots[@]} )) || return 0
  entries=$(find "${roots[@]}" "${prunes[@]}" -name .git -prune -print) || {
    warn "Could not scan all writable mounts for git metadata."
    return 1
  }
  while read -r entry; do
    [[ $entry ]] || continue
    if [[ -d $entry || -L $entry || ! -f $entry || $(stat -f %Sf "$entry") != *uchg* ]]; then
      echo "$entry"
    fi
  done <<< "$entries"
}

store_overlaps_a_mount() {
  for i in "${!M_LOC[@]}"; do
    [[ ${M_RW[i]} == false ]] && within "${M_LOC[i]}" "$STORE" && continue
    overlaps "$STORE" "${M_LOC[i]}" && { echo "${M_LOC[i]}"; return; }
  done
  return 1
}

store_path() {
  if [[ $1 == "$HOME"/* ]]; then
    echo "$STORE/${1#"$HOME"/}.git"
  else
    echo "$STORE/${1#/}.git"
  fi
}

harden() {
  instance_exists || { warn "No instance $INST: nothing to read its mounts from."; return 1; }
  ours || return 1
  instance_store || return 1
  load_mounts || return 1
  if hit=$(store_overlaps_a_mount); then
    warn "Refusing: store $STORE overlaps a mount the guest can see: $hit"
    return 1
  fi

  list=$(exposed) || return 1
  if [[ -z $list ]]; then
    echo "Nothing to move: no git metadata reachable from the guest."
    return
  fi

  moved=0 failed=0
  while read gitdir; do
    wt=${gitdir%/.git}
    dest=$(store_path "$wt")

    if [[ ! -d $gitdir || -L $gitdir ]]; then
      warn "skip   $wt: unprotected .git pointer; inspect it before using git. harden does not bless arbitrary pointers."
      failed=1; continue
    fi

    if [[ -d $gitdir/modules ]]; then
      warn "skip   $wt: has submodules; their relative pointers would break"
      failed=1; continue
    fi
    if [[ $(git -C "$wt" config --get core.worktree) ]]; then
      warn "skip   $wt: core.worktree is set"
      failed=1; continue
    fi
    if [[ -e $dest ]]; then
      warn "skip   $wt: $dest already exists"
      failed=1; continue
    fi
    if [[ $DRY ]]; then
      echo "would  $wt -> $dest"
      continue
    fi

    # Older instances may not have created the private store yet.
    [[ -d $STORE ]] || mkdir -p -m 700 "$STORE"
    if ! mkdir -p "${dest%/*}" || ! mv "$gitdir" "$dest"; then
      warn "FAIL   $wt: could not move metadata"
      failed=1; continue
    fi
    echo "gitdir: $dest" > "$gitdir"

    if [[ $(git -C "$wt" rev-parse --absolute-git-dir) != "$dest" ]]; then
      rm -f "$gitdir"; mv "$dest" "$gitdir"
      warn "FAIL   $wt: pointer did not resolve; rolled back"
      failed=1; continue
    fi
    if ! chflags uchg "$gitdir"; then
      warn "FAIL   $wt: moved, but pointer not locked"
      failed=1; continue
    fi

    echo "moved  $wt"
    ((moved++))
  done <<< "$list"

  [[ $DRY ]] || echo "$moved moved."
  return "$failed"
}

# --- Undo and removal ----------------------------------------------------

# One snapshot of Lab-built instances; no other Lima instance is ours to
# stop or delete. Commas separate the fixed fields; the store is last so
# its path may contain commas as well as spaces.
lab_instances() {
  local rooms name status agent store
  LAB_INSTANCES=(); LAB_STATUSES=(); LAB_STORES=()
  rooms=$(lima list --format '{{.Name}},{{.Status}},{{index .Config.Param "LabAgentUser"}},{{index .Config.Param "LabGitStore"}}') || return 1
  while IFS=, read -r name status agent store; do
    [[ $name && $agent ]] || continue
    LAB_INSTANCES+=("$name"); LAB_STATUSES+=("$status"); LAB_STORES+=("$store")
  done <<< "$rooms"
}

no_lab_running() {
  local j
  lab_instances || return 1
  for j in "${!LAB_INSTANCES[@]}"; do
    [[ ${LAB_STATUSES[j]} == Running ]] || continue
    warn "Refusing to unharden: Lab instance ${LAB_INSTANCES[j]} is running. Exit it first."
    return 1
  done
}

# Only a pointer to this repo's exact store entry counts, not a worktree
# link or a .git symlink. Resolve the target: a relocated store can still
# be named through its original symlink path.
points_home() {
  local pointer target
  [[ -f $1/.git && ! -L $1/.git ]] || return 1
  pointer=$(cat "$1/.git") || return 1
  [[ $pointer == 'gitdir: /'* ]] || return 1
  target=$(physical "${pointer#gitdir: }") || return 1
  [[ $target == "$2" ]]
}

# Invert the store layout by testing both possible worktree paths. The
# pointer, not the layout, establishes which one owns the metadata. Moved
# or deleted worktrees leave an orphan; never guess where their history goes.
unharden_plan() {
  local entries dest relative candidate wt owner
  UNHARDEN_REPOS=(); UNHARDEN_META=(); ORPHANS=()
  [[ -d $STORE ]] || return 0
  # A worktree's parent may itself be named *.git. Prune only metadata,
  # not those ordinary path components; HEAD or objects also recognizes a
  # damaged repo whose other marker is missing, so it can be rolled back.
  entries=$(find "$STORE" -mindepth 1 -type d -name '*.git' \( -exec test -e '{}/HEAD' \; -o -exec test -d '{}/objects' \; \) -prune -print) || return 1
  while IFS= read -r dest; do
    [[ $dest ]] || continue
    relative=${dest#"$STORE"/}; relative=${relative%.git}
    owner=""
    for candidate in "$HOME/$relative" "/$relative"; do
      [[ -d $candidate ]] || continue
      wt=$(physical "$candidate") || return 1
      [[ $(store_path "$wt") == "$dest" ]] || continue
      points_home "$wt" "$dest" || continue
      if [[ $owner && $owner != "$wt" ]]; then
        warn "Cannot match $dest: both $owner and $wt point to it. Inspect them first."
        return 1
      fi
      owner=$wt
    done
    if [[ $owner ]]; then
      UNHARDEN_REPOS+=("$owner"); UNHARDEN_META+=("$dest")
    else
      ORPHANS+=("$dest")
    fi
  done <<< "$entries"
}

restore_pointer() {
  echo "gitdir: $2" > "$1/.git" && chflags uchg "$1/.git"
}

# A failed move restores the locked pointer. If git cannot open the moved
# repo, put its metadata back too; never delete history to recover a failure.
unharden_repo() {
  local wt dest gitdir
  wt=$1; dest=$2; gitdir=$wt/.git
  points_home "$wt" "$dest" && [[ -d $dest && ! -L $dest ]] || {
    warn "FAIL   $wt: not a pointer to its protected metadata at $dest"
    return 1
  }
  if [[ $DRY ]]; then
    echo "would  $dest -> $gitdir"
    return 0
  fi
  chflags nouchg "$gitdir" || return 1
  if ! rm "$gitdir"; then
    chflags uchg "$gitdir"
    return 1
  fi
  if ! mv "$dest" "$gitdir"; then
    restore_pointer "$wt" "$dest" || warn "FAIL   $wt: move incomplete; inspect $gitdir and $dest before rerunning"
    return 1
  fi
  if [[ $(git -C "$wt" rev-parse --absolute-git-dir) != "$gitdir" ]]; then
    if mv "$gitdir" "$dest" && restore_pointer "$wt" "$dest"; then
      warn "FAIL   $wt: git could not open the restored repo; rolled back"
    else
      warn "FAIL   $wt: rollback incomplete; inspect $gitdir and $dest before continuing"
    fi
    return 1
  fi
  echo "restored  $wt"
}

unharden() {
  local wt dest j failed
  # Share entry's kernel lock so a managed room cannot start between the
  # running check and the move. A dry run only observes, creating nothing.
  if [[ ! $DRY && -d $LIMA_DIR ]]; then lifecycle_lock || return 1; fi
  no_lab_running || return 1
  if [[ $ALL ]]; then
    unharden_plan || return 1
  else
    wt=$(normalize "$UNHARDEN_REPO") || return 1
    dest=$(store_path "$wt")
    UNHARDEN_REPOS=("$wt"); UNHARDEN_META=("$dest"); ORPHANS=()
  fi
  failed=0
  for j in "${!UNHARDEN_REPOS[@]}"; do
    unharden_repo "${UNHARDEN_REPOS[j]}" "${UNHARDEN_META[j]}" || failed=1
  done
  for dest in "${ORPHANS[@]}"; do warn "orphan $dest: no matching repo pointer; left untouched"; done
  (( ${#UNHARDEN_REPOS[@]} + ${#ORPHANS[@]} )) || echo 'Nothing to move: no protected metadata found.'
  return "$failed"
}

# Uninstall includes every recorded store, the default and an override,
# without relying on whichever instance happens to be named by --instance.
uninstall_stores() {
  local path resolved prior seen
  REMOVE_STORES=()
  for path in "$STORE" "$LAB_HOME/git" "${LAB_STORES[@]}"; do
    [[ $path ]] || continue
    [[ -d $path ]] || continue
    resolved=$(physical "$path") || return 1
    seen=""
    for prior in "${REMOVE_STORES[@]}"; do [[ $prior == "$resolved" ]] && seen=1; done
    [[ $seen ]] || REMOVE_STORES+=("$resolved")
  done
}

# Only a real ~/.lab directory is recursively removed. A symlink there
# preserves the whole relocated installation; other external targets and
# store overrides likewise remain. Restoring live histories is separate.
removal_action() {
  if [[ ! -L $HOME/.lab ]] && within "$1" "$LAB_HOME"; then echo DELETE; else echo KEEP; fi
}

# Report relocation links without resolving them, including dangling ones.
# No state file is read, no internal symlink is followed, and bundles are
# conservatively called possibly unfetched: Lab has no fetch receipt.
uninstall_data_plan() {
  local region path kind
  for region in secrets state; do
    path=$LAB_HOME/$region
    kind=credentials
    [[ $region == state ]] && kind='persistent state (transcripts, backups and possibly unfetched delivery bundles)'
    if [[ -L $path ]]; then
      echo "  do not follow $kind link: $path -> $(readlink "$path")"
      continue
    fi
    for path in "$LAB_HOME/$region"/*; do
      if [[ -L $path ]]; then
        echo "  do not follow $kind link: $path -> $(readlink "$path")"
      elif [[ -e $path ]]; then
        echo "  $(removal_action "$path") $kind: $path"
      fi
    done
  done
  [[ ! -L $LAB_HOME/git ]] || echo "  do not follow git-store link: $LAB_HOME/git -> $(readlink "$LAB_HOME/git")"
  return 0
}

# %q makes element boundaries unambiguous even with spaces in paths.
unharden_signature() { printf '%q\n' "${UNHARDEN_REPOS[@]}" -- "${UNHARDEN_META[@]}" -- "${ORPHANS[@]}"; }

uninstall() {
  local store j reply path
  if [[ ! $DRY && -d $LIMA_DIR ]]; then lifecycle_lock || return 1; fi
  lab_instances && uninstall_stores || return 1
  echo 'Uninstall Lab:'
  for j in "${!LAB_INSTANCES[@]}"; do
    echo "  stop/delete instance ${LAB_INSTANCES[j]} (${LAB_STATUSES[j]})"
  done
  RESTORE_REPOS=(); RESTORE_META=(); PLAN_SIGNATURES=()
  for store in "${REMOVE_STORES[@]}"; do
    STORE=$store
    unharden_plan || return 1
    PLAN_SIGNATURES+=("$(unharden_signature)")
    RESTORE_REPOS+=("${UNHARDEN_REPOS[@]}"); RESTORE_META+=("${UNHARDEN_META[@]}")
    for j in "${!UNHARDEN_REPOS[@]}"; do echo "  unharden ${UNHARDEN_REPOS[j]}"; done
    for path in "${ORPHANS[@]}"; do echo "  $(removal_action "$path") orphaned history $path"; done
    [[ $(removal_action "$store") == KEEP ]] && echo "  KEEP external git store $store (after moving live histories home)"
  done
  uninstall_data_plan
  [[ -L $HOME/.lab ]] && echo "  KEEP relocated installation target: $HOME/.lab -> $(readlink "$HOME/.lab")"
  echo "  DELETE $HOME/.lab (links are removed, not followed; targets inside the deleted tree still go)"
  echo '  Save anything you need from the locations marked DELETE before continuing.'
  [[ $DRY ]] && { echo 'Dry run: nothing changed.'; return 0; }
  reply=""
  read -r -p 'Remove Lab and the data listed above? [y/N] ' reply
  [[ $reply == [yY]* ]] || { echo 'Uninstall cancelled.'; return 1; }
  for j in "${!LAB_INSTANCES[@]}"; do
    [[ ${LAB_STATUSES[j]} == Running ]] || continue
    lima stop "${LAB_INSTANCES[j]}" || return 1
  done
  # A running guest could have renamed a worktree while its user read the
  # warning. Do not silently turn a promised restore into orphan deletion.
  for j in "${!REMOVE_STORES[@]}"; do
    STORE=${REMOVE_STORES[j]}
    unharden_plan || return 1
    [[ $(unharden_signature) == "${PLAN_SIGNATURES[j]}" ]] || {
      warn 'Uninstall stopped: repo pointers changed while confirming. Nothing has been deleted; inspect and rerun for a fresh plan.'
      return 1
    }
  done
  for j in "${!RESTORE_REPOS[@]}"; do
    unharden_repo "${RESTORE_REPOS[j]}" "${RESTORE_META[j]}" || {
      warn 'Uninstall stopped: no instances or stored histories have been deleted. Fix the failed move and rerun.'
      return 1
    }
  done
  for j in "${!LAB_INSTANCES[@]}"; do lima delete "${LAB_INSTANCES[j]}" || return 1; done
  rm -rf "$HOME/.lab" || return 1
  echo 'Lab removed. Remove the ~/.lab/bin PATH line you added to your shell profile.'
}

# --- The interview -------------------------------------------------------
#
# Every answer can be left empty, and empty takes the default: nothing on
# create, the current answer on a rebuild. --yes takes every default unasked.

# An answer as a physical absolute path to an existing directory.
normalize() {
  d=$1
  [[ $d == "~" ]] && d=$HOME
  [[ $d == "~/"* ]] && d=$HOME/${d:2}
  [[ $d == /* ]] || d=$PWD/$d
  [[ -d $d ]] || { echo "    not a directory: $d" >&2; return 1; }
  cd -P "$d" && pwd
}

# ask_dirs <kind>: fills DIRS, one directory per answer, empty to finish.
ask_dirs() {
  DIRS=()
  [[ $YES ]] && return
  while read -e -p "  $1 directory (empty to finish): " d && [[ $d ]]; do
    d=$(normalize "$d") && DIRS+=("$d")
  done
}

# ask_dir_list <kind> <default>...: fills DIRS, offering the defaults first.
ask_dir_list() {
  kind=$1
  shift
  if (( $# )); then
    echo "$kind directories now:"
    for d in "$@"; do echo "    $d"; done
    if ask_yes "Keep them?" y; then DIRS=("$@"); return; fi
  fi
  [[ $YES ]] || echo "$kind directories, each appearing in the guest at its host path:"
  ask_dirs "$kind"
}

available_mixins() {
  for d in "$GUEST"/mixins/*/; do
    [[ -f $d/provision.bash ]] && basename "$d"
  done
}

# Recorded mixins are space-separated capability names, not all harnesses.
has_mixin() {
  for m in $1; do   # split the mixin list on purpose
    [[ $m == "$2" ]] && return 0
  done
  return 1
}

# A harness marker offers the mixin's command as a default candidate.
harness_mixins() {
  for name in $1; do   # one mixin per word: split on purpose
    [[ -f $GUEST/mixins/$name/harness ]] && echo "$name"
  done
}

# ask_mixins <current>: fills MIX, one y/n per mixin in the repo, defaulting
# to yes for those the instance already has.
ask_mixins() {
  MIX=()
  for name in $(available_mixins); do   # one mixin per word: split on purpose
    def=n
    [[ " $1 " == *" $name "* ]] && def=y
    if ask_yes "  Mixin $name?" "$def"; then MIX+=("$name"); fi
  done
}

# ask_harness: choose a default from the selected harnesses.
ask_harness() {
  HARNESSES=()
  for name in $(harness_mixins "${MIX[*]}"); do HARNESSES+=("$name"); done
  DEFAULT_HARNESS=${HARNESSES[0]}
  (( ${#HARNESSES[@]} > 1 )) || return 0
  if has_mixin "${HARNESSES[*]}" "$D_HARNESS"; then
    DEFAULT_HARNESS=$D_HARNESS
  fi
  [[ $YES ]] && return
  while :; do
    answer=""
    read -p "  Default harness (${HARNESSES[*]}) [$DEFAULT_HARNESS]: " answer
    answer=${answer:-$DEFAULT_HARNESS}
    if has_mixin "${HARNESSES[*]}" "$answer"; then
      DEFAULT_HARNESS=$answer
      return
    fi
    echo "    choose one of: ${HARNESSES[*]}"
  done
}

# interview: fills RW, RO, MIX, DEFAULT_HARNESS, offering the instance's
# current answers back on rebuild.
interview() {
  [[ $YES ]] || echo "Instance $INST"
  ask_dir_list "Read-write" "${D_RW[@]}"; RW=("${DIRS[@]}")
  ask_dir_list "Read-only" "${D_RO[@]}"; RO=("${DIRS[@]}")
  ask_mixins "$D_MIX"
  ask_harness
}

# The plan's walls, before anything is mounted.
provision_source() {
  script=$(realpath "$1") || return 1
  [[ -f $script ]] && within "$script" "${2:-$GUEST}" || {
    warn "Refusing: source $1 must be a regular file within ${2:-$GUEST}."
    return 1
  }
}

mixin_sources() {
  local m
  for m in "${MIX[@]}"; do
    [[ $m =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || { warn "Invalid mixin name: $m"; return 1; }
    [[ $(physical "$GUEST/mixins/$m") == "$GUEST/mixins/$m" ]] || { warn "Mixin $m must not redirect outside its directory."; return 1; }
    provision_source "$GUEST/mixins/$m/provision.bash" "$GUEST/mixins/$m" || return 1
  done
  return 0
}

# A mixin's optional mounts file is data, never sourced as host shell:
#   parameter<TAB>source<TAB>guest-path
# Sources reference core path facts (@Key), not arbitrary host paths.
# Each row contributes a path param and one read-only mount. No host hooks.
mixin_resources() {
  local mixin key source target extra value i found recorded_value path_keys path_values
  PARAM_KEYS=(LabAgentUser LabMixins LabHarness LabGitStore)
  PARAM_VALUES=("$AGENT" "${MIX[*]}" "$DEFAULT_HARNESS" "$STORE")
  # Only intentionally shared path facts may be referenced, not arbitrary
  # string params which happen to look like paths.
  path_keys=(LabGitStore); path_values=("$STORE")
  RESOURCE_LOC=(); RESOURCE_PT=()
  for mixin in "${MIX[@]}"; do
    [[ -e $GUEST/mixins/$mixin/mounts || -L $GUEST/mixins/$mixin/mounts ]] || continue
    provision_source "$GUEST/mixins/$mixin/mounts" "$GUEST/mixins/$mixin" || return 1
    while IFS=$'\t' read -r key source target extra || [[ $key ]]; do
      [[ $key && $key != \#* ]] || continue
      [[ $key =~ ^[A-Z][A-Za-z0-9]*$ && $source && $target && ! $extra ]] || {
        warn "Invalid mount declaration in mixin $mixin: expected parameter, source and guest path, tab-separated."
        return 1
      }
      has_mixin "${PARAM_KEYS[*]}" "$key" && { warn "Duplicate param $key in mixin $mixin."; return 1; }
      [[ $source == @* ]] || { warn "Mount $key must reference a core path fact, not an arbitrary host path."; return 1; }
      found=""
      for i in "${!path_keys[@]}"; do
        [[ ${path_keys[i]} == "${source#@}" ]] && { value=${path_values[i]}; found=1; break; }
      done
      [[ $found ]] || { warn "Unknown core path fact $source in mixin $mixin."; return 1; }
      [[ $value == /* && $target == /* && $target != / && $target != */ ]] || {
        warn "Mount $key needs an absolute host directory and guest path."; return 1;
      }
      case $target/ in
        *//*|*/./*|*/../*) warn "Mount $key has a non-canonical guest path: $target"; return 1 ;;
      esac
      case $value/ in
        *//*|*/./*|*/../*) warn "Mount $key has a non-canonical host path: $value"; return 1 ;;
      esac
      value=$(physical "$value") || return 1
      if [[ $1 == recorded ]]; then
        recorded_value=$(param "$key")
        [[ $recorded_value == "$value" ]] || { warn "Param $key does not match its declaration in $INST; rebuild it."; return 1; }
      fi
      [[ ! -e $value || -d $value ]] || { warn "Mount $key is not a host directory: $value"; return 1; }
      PARAM_KEYS+=("$key"); PARAM_VALUES+=("$value")
      RESOURCE_LOC+=("$value"); RESOURCE_PT+=("$target")
    done < "$GUEST/mixins/$mixin/mounts"
  done
  return 0
}

resource_walls() {
  local i prior target
  for i in "${!RESOURCE_LOC[@]}"; do
    readonly_wall "${RESOURCE_LOC[i]}" || return 1
    target=${RESOURCE_PT[i]}
    for prior in /lab /mnt/lab-state "$@" "${RESOURCE_PT[@]:0:i}"; do
      overlaps "$target" "$prior" && { warn "Mixin mount $target overlaps guest mount $prior."; return 1; }
    done
  done
  return 0
}

# Quote data, including manifest values, rather than interpolating YAML syntax.
yaml() {
  local value=$1
  value=${value//\\/\\\\}; value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}; value=${value//$'\r'/\\r}; value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

check_plan() {
  bad=0
  provision_source "$GUEST/base.bash" || bad=1
  mixin_sources || bad=1
  repo_wall "${RW[@]}" || bad=1
  private_wall "${RW[@]}" "${RO[@]}" || bad=1
  state_wall || bad=1
  store_wall || bad=1
  mixin_resources && resource_walls "${RW[@]}" "${RO[@]}" || bad=1
  (( bad == 0 ))
}

summary() {
  echo -e "\nInstance:    $INST"
  echo "Agent:       $AGENT"
  for d in "${RW[@]}"; do echo "Read-write:  $d"; done
  for d in "${RO[@]}"; do echo "Read-only:   $d"; done
  echo "Lab tools:   $GUEST/bin, read-only at /lab/bin"
  for m in "${MIX[@]}"; do echo "Mixin:       $GUEST/mixins/$m, read-only at /lab/mixins/$m"; done
  echo "Git wall:    protected host metadata in $STORE"
  for i in "${!RESOURCE_LOC[@]}"; do echo "Read-only:   ${RESOURCE_LOC[i]} at ${RESOURCE_PT[i]}"; done
  echo "State:       $STATE, read-write at /mnt/lab-state"
  echo "Mixins:      ${MIX[*]:-none}"
  echo "Harness:     ${DEFAULT_HARNESS:-shell}"
  echo -e "Secrets:     $SECRETS\n"
}

# --- Generation and creation ----------------------------------------------

gen_config() {
  cat <<EOF
# Generated by lab for instance $INST.
vmType: "vz"
arch: "aarch64"
mountType: "virtiofs"
containerd:
  system: false
  user: false
images:
  - location: $(yaml "$IMAGE")
    arch: "aarch64"
param:
EOF
  for i in "${!PARAM_KEYS[@]}"; do
    echo "  $(yaml "${PARAM_KEYS[i]}"): $(yaml "${PARAM_VALUES[i]}")"
  done
  echo 'mounts:'
  for d in "${RW[@]}"; do
    cat <<EOF
  - location: $(yaml "$d")
    writable: true
EOF
  done
  for d in "${RO[@]}"; do
    cat <<EOF
  - location: $(yaml "$d")
    writable: false
EOF
  done
  for i in "${!RESOURCE_LOC[@]}"; do
    cat <<EOF
  - location: $(yaml "${RESOURCE_LOC[i]}")
    mountPoint: $(yaml "${RESOURCE_PT[i]}")
    writable: false
EOF
  done
  cat <<EOF
  - location: $(yaml "$GUEST/bin")
    mountPoint: "/lab/bin"
    writable: false
EOF
  for m in "${MIX[@]}"; do
    cat <<EOF
  - location: $(yaml "$GUEST/mixins/$m")
    mountPoint: $(yaml "/lab/mixins/$m")
    writable: false
EOF
  done
  cat <<EOF
  - location: $(yaml "$STATE")
    mountPoint: "/mnt/lab-state"
    writable: true
provision:
  - mode: system
    file: $(yaml "$GUEST/base.bash")
EOF
  for m in "${MIX[@]}"; do
    cat <<EOF
  - mode: system
    file: $(yaml "$GUEST/mixins/$m/provision.bash")
EOF
  done
}

# plan: the interview's answers, checked, shown, written to a fresh temp
# dir as CFG, and validated. Validate embeds every provision file, so a
# missing one fails here, before anything changes.
plan() {
  interview || return 1
  check_plan || return 1
  summary
  CFG=$(mktemp -d)/$INST.yaml || return 1
  gen_config > "$CFG"
  if [[ $SHOW ]]; then
    echo "--- generated config ---"
    cat "$CFG"
    echo "--- end of config ---"
  fi
  lima validate "$CFG" || { discard; return 1; }
}

# The plan's temp config, removed whenever the plan stops short of create.
discard() { rm -rf "${CFG%/*}"; }

# lima_create: prepares the core directories, then the instance.
# The config is kept only if limactl create itself fails.
lima_create() {
  if [[ ! -d $SECRETS ]]; then
    mkdir -p -m 700 "$SECRETS" || { discard; return 1; }
  fi
  if [[ ! -d $STATE ]]; then
    mkdir -p -m 700 "$STATE" || { discard; return 1; }
  fi
  if [[ ! -d $STORE ]]; then
    mkdir -p -m 700 "$STORE" || { discard; return 1; }
  fi
  if ! lima create --name "$INST" --tty=false "${SIZE[@]}" "$CFG"; then
    warn "limactl create failed. The generated config is kept at $CFG"
    return 1
  fi
  discard
  echo "Created $INST."
}

create_instance() {
  if instance_exists; then
    warn "Instance $INST already exists. To build it again: lab rebuild --instance $INST"
    return 1
  fi
  D_RW=(); D_RO=(); D_MIX=""; D_HARNESS=""
  plan || return 1
  if [[ $DRY ]]; then
    discard
    echo "Dry run: nothing created."
    return
  fi
  confirm "Create $INST?" || { discard; return 1; }
  lima_create
}

rebuild() {
  instance_exists || die "No instance $INST to rebuild. \`lab create --instance $INST\` makes one."
  ours || exit 1

  # Mirror mounts only are offered back, which also leaves out the guest files at /lab.
  load_mounts || exit 1
  D_RW=(); D_RO=()
  for i in "${!M_LOC[@]}"; do
    [[ ${M_PT[i]} == "${M_LOC[i]}" ]] || continue
    if [[ ${M_RW[i]} == true ]]; then D_RW+=("${M_LOC[i]}"); else D_RO+=("${M_LOC[i]}"); fi
  done
  D_MIX=$(param LabMixins)
  D_HARNESS=$(param LabHarness)

  plan || exit 1
  if [[ $DRY ]]; then
    discard
    echo "Dry run: $INST left as it is."
    return
  fi
  confirm "Delete $INST and build it again? Guest-only files and sign-ins are lost; transcripts on the state mount survive." || { discard; exit 1; }
  lima delete "$INST" || { discard; exit 1; }
  lima_create || exit 1
}

# --- Keys ------------------------------------------------------------------

# A command in the guest as the agent. Callers that aren't feeding it input
# close stdin, so a call never swallows input meant for the session.
as_agent() { lima shell --workdir / "$INST" sudo -u "$AGENT" "$@"; }

# import_keys: atomically replaces each key, then removes withdrawn keys.
# A joining shell must not make the directory disappear while another
# login profile is exporting it. Base exports keys from every login shell.
# A missing secrets directory is recreated empty.
import_keys() {
  local keys file names
  keys=/home/$AGENT/.lab/keys
  as_agent sh -c 'umask 077; mkdir -p "$1" && rm -f "$1"/.key.*' sh "$keys" < /dev/null || return 1
  if [[ ! -d $SECRETS ]]; then
    mkdir -p -m 700 "$SECRETS" || return 1
    echo "Recreated the missing secrets directory $SECRETS, empty."
  fi
  [[ -r $SECRETS && -x $SECRETS ]] || { warn "Cannot read secrets directory $SECRETS."; return 1; }
  names=()
  for file in "$SECRETS"/*; do
    [[ -f $file ]] || continue
    names+=("${file##*/}")
    as_agent sh -c '
      umask 077
      tmp=$(mktemp "$1/.key.XXXXXX") || exit 1
      trap '\''rm -f "$tmp"'\'' EXIT
      cat > "$tmp" && mv -Tf "$tmp" "$1/$2"
    ' sh "$keys" "${file##*/}" < "$file" || return 1
  done
  as_agent bash -c '
    keys=$1; shift
    for file in "$keys"/*; do
      [[ -e $file || -L $file ]] || continue
      keep=""
      for name in "$@"; do [[ ${file##*/} == "$name" ]] && { keep=1; break; }; done
      [[ $keep ]] || rm -rf "$file" || exit 1
    done
    exit 0
  ' bash "$keys" "${names[@]}" < /dev/null
}

# --- Start -----------------------------------------------------------------

# One kernel lock serializes boot/join and last-out shutdown in this Lima
# home. Keep its inode: deleting a lock file could strand another waiter.
# Perl exposes flock (2 = LOCK_EX) on macOS versions whose lockf lacks descriptor mode.
lifecycle_lock() {
  exec 9<> "$LIMA_DIR/.lab-lifecycle.lock" || return 1
  /usr/bin/perl -e 'flock(STDIN, 2) or die "lab: lifecycle lock: $!\n"' <&9 || {
    exec 9>&-
    return 1
  }
}

lifecycle_unlock() { exec 9>&-; }

other_instances() {
  local rooms
  rooms=$(lima list --format '{{.Name}} {{.Status}}') || return 1
  running=$(awk -v me="$INST" '$2 == "Running" && $1 != me { print $1 }' <<< "$rooms")
  [[ ! $running ]] || { warn "Refusing to start: another Lima instance is running: $running"; return 1; }
}

# Select our live shell processes, not hostagents, SSH children, key import
# or shell arguments which happen to mention a room. The tag distinguishes
# the same instance name in different LIMA_HOME directories. It is just a
# process argument, never a counter or a guest-supplied claim.
select_sessions() {
  awk -v instance="$INST" -v tag="$SESSION_TAG" '
    $3 ~ /(^|\/)limactl$/ && $4 == "--log-level" && $5 == "warn" &&
    $6 == "shell" && $7 == "--workdir" && $8 == "/" && $9 == instance &&
    index(" " $0 " ", " " tag " ") { print $1 }
  '
}

read_sessions() {
  SESSION_PROCESSES=$(ps -ww -U "$UID" -o pid=,ppid=,args=) || return 1
  SESSION_PIDS=$(select_sessions <<< "$SESSION_PROCESSES")
}

session_signal() {
  if [[ $SESSION_PID ]]; then
    kill -s "$1" "$SESSION_PID" 2>/dev/null   # it may have just exited
  else
    exit "$2"
  fi
}

start() {
  other_instances || exit 1

  if ! instance_exists; then
    [[ -t 0 ]] || die "No instance $INST; run: lab create --instance $INST"
    create_instance || exit 1
    [[ $DRY ]] && return
  fi
  if [[ ! $DRY ]]; then
    [[ -x /usr/bin/perl ]] || die "Session coordination needs macOS's /usr/bin/perl."
    SESSION_TAG=$(printf '%s\n' "$LIMA_DIR/$INST" | shasum -a 256) || exit 1
    SESSION_TAG=lab-session-${SESSION_TAG%% *}
    SESSION_PID=""
    trap lifecycle_unlock EXIT
    trap 'session_signal INT 130' INT
    trap 'session_signal TERM 143' TERM
    trap 'session_signal HUP 129' HUP
    lifecycle_lock || exit 1
    # The earlier check was before any interactive create or lock wait.
    other_instances || exit 1
  fi
  ours || exit 1
  instance_store || exit 1
  AGENT=$(param LabAgentUser)
  mixins=$(param LabMixins)
  read -r -a MIX <<< "$mixins"
  mixin_sources && mixin_resources recorded || exit 1
  COMMAND=${COMMAND:-$(param LabHarness)}
  COMMAND=${COMMAND:-bash}

  load_mounts || exit 1
  user_mounts || exit 1
  repo_wall "${USER_RW[@]}" || exit 1
  private_wall "${USER_LOC[@]}" || exit 1
  state_wall || exit 1
  store_wall || exit 1
  resource_walls "${USER_PT[@]}" || exit 1

  left=$(exposed) || die "Refusing to start: the git metadata scan did not complete."
  if [[ $left ]]; then
    warn "Refusing to start: git metadata reachable from the guest:"
    echo "$left" >&2
    die "Run: lab harden --instance $INST"
  fi
  if [[ $DRY ]]; then
    echo "Dry run: checks pass; $INST would start."
    return
  fi


  if [[ ! -d $STATE ]]; then
    mkdir -p -m 700 "$STATE" || exit 1
    echo "Recreated the missing state directory $STATE, empty."
  fi
  status=$(lima list "$INST" --format '{{.Status}}') || exit 1
  started_here=""
  if [[ $status == Running ]]; then
    echo "Entering $INST: joining the running VM..."
  else
    # Lima's INFO lines are suppressed, so say what the wait is for.
    echo "Entering $INST: starting the VM..."
    lima start --tty=false "$INST" < /dev/null || exit 1
    started_here=1
  fi
  if ! import_keys; then
    [[ $started_here ]] && lima stop "$INST" < /dev/null
    die "Key import failed; not opening a session."
  fi

  # Land where you are if a mount puts that path in the guest, else in the
  # agent's home. A login shell exports the keys before it execs the
  # command. The room exists while that command runs.
  land=/home/$AGENT
  here=$(pwd -P)
  for i in "${!M_LOC[@]}"; do
    [[ ${M_PT[i]} == "${M_LOC[i]}" ]] && within "$here" "${M_LOC[i]}" && land=$here
  done
  # Launch while locked, retaining terminal stdin and normal child signals.
  # The session must not inherit the lifecycle lock itself.
  # Keep the script single-line so ps sees the tag before any user newlines.
  (trap - INT QUIT HUP TERM; exec "${LIMACTL[@]}" shell --workdir / "$INST" sudo -H -u "$AGENT" bash -lc \
    'cd "$1" || exit 1; shift; [[ $(type -P -- "$1") ]] || { echo "lab: command not found in guest: $1" >&2; exit 127; }; exec "$@"' \
    "$SESSION_TAG" "$land" "$COMMAND" "${ARGS[@]}") <&0 9>&- &
  SESSION_PID=$!
  session_setup_failed=""
  while :; do
    if ! read_sessions; then
      warn "Cannot observe host sessions; cancelling this entry."
      session_setup_failed=1
      kill -TERM "$SESSION_PID" 2>/dev/null   # it may have just exited
      break
    fi
    has_mixin "$SESSION_PIDS" "$SESSION_PID" && break
    # The child can finish before the first snapshot, or fail before exec.
    awk -v pid="$SESSION_PID" -v parent="$$" '$1 == pid && $2 == parent && $3 != "<defunct>" { found=1 } END { exit !found }' <<< "$SESSION_PROCESSES" || break
    sleep 0.05
  done
  lifecycle_unlock

  # A trapped signal can interrupt wait before its child has finished.
  while :; do
    wait "$SESSION_PID"
    session_rc=$?
    has_mixin "$(jobs -pr)" "$SESSION_PID" || break
  done
  SESSION_PID=""
  [[ $session_setup_failed ]] && session_rc=1

  stop_rc=0
  if ! lifecycle_lock || ! read_sessions; then
    warn "Cannot coordinate shutdown; leaving $INST running."
    stop_rc=1
  elif [[ $SESSION_PIDS ]]; then
    echo "Leaving $INST: other sessions remain; the VM stays running."
  elif ! status=$(lima list "$INST" --format '{{.Status}}'); then
    warn "Cannot inspect $INST for shutdown."
    stop_rc=1
  elif [[ $status == Stopped ]]; then
    echo "Leaving $INST: the VM is already stopped."
  else
    echo "Leaving $INST: last session, stopping the VM..."
    lima stop "$INST" < /dev/null || stop_rc=$?
  fi
  lifecycle_unlock

  left=$(exposed) || die "The exit git metadata scan did not complete. Inspect the writable mounts before using git."
  if [[ $left ]]; then
    echo -e "\nWARNING: git metadata appeared in a mount during this session:" >&2
    echo "$left" >&2
    echo "Do not run git there until you have inspected it." >&2
    exit 1
  fi
  (( session_rc == 0 && stop_rc != 0 )) && return "$stop_rc"
  return "$session_rc"
}

# --- Arguments ---------------------------------------------------------

main() {
  VERB="" INST=lab INSTANCE_CHOSEN="" SHOW="" DRY="" YES="" SIZE=() COMMAND="" ARGS=() ALL="" UNHARDEN_REPO=""
  while (( $# )); do
    case $1 in
      create|rebuild|harden|unharden|uninstall) [[ -z $VERB ]] || die "Choose one Lab verb."; VERB=$1; shift ;;
      --instance) [[ $2 ]] || die "--instance needs a name"; INST=$2; INSTANCE_CHOSEN=1; shift 2 ;;
      --cpus|--memory|--disk) [[ $2 ]] || die "$1 needs a value"; SIZE+=("$1" "$2"); shift 2 ;;
      --show) SHOW=1; shift ;;
      --yes)  YES=1; shift ;;
      --all)  ALL=1; shift ;;
      -n)     DRY=1; shift ;;
      -h|--help) usage; exit ;;
      --)
        shift
        if [[ $VERB == unharden ]]; then
          [[ $# == 1 && ! $UNHARDEN_REPO ]] || die "Choose one repo, or --all."
          UNHARDEN_REPO=$1
        else
          ARGS=("$@")
        fi
        break ;;
      -*) usage >&2; exit 1 ;;
      *)
        if [[ $VERB == unharden ]]; then
          [[ ! $UNHARDEN_REPO ]] || die "Choose one repo, or --all."
          UNHARDEN_REPO=$1; shift; continue
        fi
        [[ $1 ]] || die "Guest command must not be empty."
        COMMAND=$1; shift
        ARGS=("$@"); break ;;
    esac
  done
  if [[ $INSTANCE_CHOSEN && ( $VERB == unharden || $VERB == uninstall ) ]]; then
    die "$VERB is not instance-scoped; omit --instance."
  fi
  if [[ $VERB == unharden ]]; then
    [[ ( $UNHARDEN_REPO && ! $ALL ) || ( $ALL && ! $UNHARDEN_REPO ) ]] || die "Use lab unharden <repo>, or lab unharden --all."
  elif [[ $ALL ]]; then
    die "--all is only for unharden."
  fi
  if [[ $VERB && ( $COMMAND || ${#ARGS[@]} -gt 0 ) ]]; then
    die "Guest commands are only for starting a room."
  fi
  require_lima
  if [[ $VERB != unharden && $VERB != uninstall ]]; then
    [[ $(physical "$GUEST") == "$GUEST" ]] || die "The guest source directory must not redirect outside its declared path: $GUEST"
    [[ -d $GUEST/bin && $(physical "$GUEST/bin") == "$GUEST/bin" ]] || die "The common tools must be a directory at their declared path: $GUEST/bin"
  fi
  [[ $INST =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || die "Invalid instance name: $INST"
  if [[ $VERB == uninstall && ! -d $HOME/.lab ]]; then
    LAB_HOME=$HOME/.lab   # a dangling installation link can still be removed
  else
    LAB_HOME=$(physical "$HOME/.lab") || die "Can't resolve Lab's home."
  fi
  LIMA_DIR=$(physical "$LIMA_DIR") || die "Can't resolve Lima's state directory."
  # The store by its physical path, not created here: the mounts it's tested
  # against are physical, and git's rev-parse reports physical paths, so a
  # symlinked store (macOS's /var -> /private/var) would otherwise slip past
  # the overlap test and fail every pointer's check.
  if [[ $VERB != uninstall ]]; then
    STORE=$(physical "$STORE") || die "Can't resolve the git store ${LAB_GIT_STORE:-$HOME/.lab/git}."
  fi
  # Removal is repo/store-wide, independent of a selected room's state.
  case $VERB in
    unharden) unharden; return $? ;;
    uninstall) uninstall; return $? ;;
  esac
  AGENT=$USER-agent
  SECRETS=$LAB_HOME/secrets/$INST
  STATE=$(physical "$LAB_HOME/state/$INST") || die "Can't resolve $INST's state directory."

  case $VERB in
    "")      start ;;
    create)  create_instance || exit 1 ;;
    rebuild) rebuild ;;
    harden)  harden || exit 1 ;;
  esac
}

main "$@"
