# The development repo, the default secrets directories, and the default
# git store and instance state: none of them ships.
/dev/
/secrets/
/git/
/state/
.*.sw?

# Guest tools share PATH with private user scripts. Only shipped tools ship.
/guest/bin/*
!/guest/bin/verify.sh
!/guest/bin/fd
!/guest/bin/backup.sh
!/guest/bin/backup.bash
